<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <EditText
        android:id="@+id/etCari" android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ketik kata Indonesia untuk mencari" android:inputType="text" />
    <TextView
        android:id="@+id/txtKosong" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="Tidak ditemukan" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHasil" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
